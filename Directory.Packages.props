<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Grouped versions for related packages -->
    <FluentValidationAspNetCoreVersion>11.3.1</FluentValidationAspNetCoreVersion>
    <HumanizerVersion>2.14.1</HumanizerVersion>
    <ScrutorVersion>6.1.0</ScrutorVersion>
    <!-- Microsoft.EntityFrameworkCore -->
    <MicrosoftEntityFrameworkCoreVersion>9.0.7</MicrosoftEntityFrameworkCoreVersion>
    <!-- Microsoft.AspNetCore -->
    <MicrosoftAspNetCoreVersion>9.0.7</MicrosoftAspNetCoreVersion>
    <!-- OpenTelemetry -->
    <OpenTelemetryVersion>1.12.0</OpenTelemetryVersion>
    <!-- HealthChecks -->
    <AspNetCoreHealthChecksUrisVersion>9.0.0</AspNetCoreHealthChecksUrisVersion>
    <!-- Hangfire -->
    <HangfireVersion>1.8.20</HangfireVersion>
    <!-- Azure -->
    <MicrosoftAzureAppConfigurationAspNetCoreVersion>8.2.0</MicrosoftAzureAppConfigurationAspNetCoreVersion>
    <AzureIdentityVersion>1.14.2</AzureIdentityVersion>
    <!-- Yarp -->
    <YarpReverseProxyVersion>2.3.0</YarpReverseProxyVersion>
    <!-- Test/Analyzers -->
    <CoverletCollectorVersion>6.0.4</CoverletCollectorVersion>
    <MicrosoftNETTestSdkVersion>17.14.1</MicrosoftNETTestSdkVersion>
    <XunitVersion>2.9.3</XunitVersion>
    <XunitRunnerVisualStudioVersion>3.1.1</XunitRunnerVisualStudioVersion>
    <MoqVersion>4.20.72</MoqVersion>
    <StyleCopAnalyzersVersion>1.2.0-beta.556</StyleCopAnalyzersVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FluentValidation.AspNetCore" Version="$(FluentValidationAspNetCoreVersion)" />
    <PackageVersion Include="Humanizer" Version="$(HumanizerVersion)" />
    <PackageVersion Include="Scrutor" Version="$(ScrutorVersion)" />
    <PackageVersion Include="MessagePack" Version="3.1.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftEntityFrameworkCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.6.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Certificate" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Consul" Version="1.7.14.7" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="$(AspNetCoreHealthChecksUrisVersion)" />
    <PackageVersion Include="Hangfire" Version="$(HangfireVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftAspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.Azure.AppConfiguration.AspNetCore" Version="$(MicrosoftAzureAppConfigurationAspNetCoreVersion)" />
    <PackageVersion Include="StackExchange.Redis" Version="2.7.20" />
    <PackageVersion Include="Azure.Identity" Version="$(AzureIdentityVersion)" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="$(YarpReverseProxyVersion)" />
    <PackageVersion Include="coverlet.collector" Version="$(CoverletCollectorVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageVersion Include="xunit" Version="$(XunitVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)" />
    <PackageVersion Include="moq" Version="$(MoqVersion)" />
    <PackageVersion Include="StyleCop.Analyzers" Version="$(StyleCopAnalyzersVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="All" />
  </ItemGroup>
  <!-- The rest of the file remains unchanged, with ItemGroups for project-specific references -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Abstractions'))">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Humanizer" />
    <PackageReference Include="Scrutor"/>
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.SQLServer'))">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.API'))">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Auth'))">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.HTTP'))">
    <PackageReference Include="Consul" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Observability'))">
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Saga'))">
    <PackageReference Include="Scrutor" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Jobs'))">
    <PackageReference Include="Hangfire" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Security'))">
    <PackageReference Include="Microsoft.Azure.AppConfiguration.AspNetCore" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Gateway.API'))">
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
   <ItemGroup Condition="$(MSBuildProjectName.EndsWith('BuildingBlocks.Storage'))">
         <PackageReference Include="StackExchange.Redis" />
     <PackageReference Include="MessagePack"/>

  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="moq" />
  </ItemGroup>
</Project>
